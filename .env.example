# Magic Cuts Salon — Environment Variables
# Copy to .env.local and fill in real values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (publishable key is safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Netlify Functions (server-side only — never expose in VITE_ prefix)
# Set these in Netlify dashboard → Site settings → Environment variables
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_...
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+16145551234
SHOP_EMAIL=hello@magicutsalon.com
SITE_URL=https://magicutsalon.com

# ── AI Growth Engine (server-side only — never use a VITE_ prefix) ──
# Qwen inference. At least one of these enables the agent layer; if both are set,
# AI_PROVIDER is tried first and the other is automatic failover.
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
AI_PROVIDER=groq            # groq | cerebras
# Optional model overrides (default: qwen/qwen3-32b)
AI_FAST_MODEL=qwen/qwen3-32b
AI_SMART_MODEL=qwen/qwen3-32b

# Google review link used by the post-visit review SMS.
# Replace with the "write a review" link from your Google Business Profile.
GOOGLE_REVIEW_URL=https://www.google.com/maps/search/?api=1&query=Magic+Cuts+Salon+Dublin+OH
